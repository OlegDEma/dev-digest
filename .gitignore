node_modules/
dist/
# agent-runner ships as a JS GitHub Action — its bundled dist/ MUST be committed
# (GitHub runs action.yml `main: dist/index.js` as-is, with no build step).
!agent-runner/dist/
!agent-runner/dist/**
build/
.next/
out/
coverage/
*.tsbuildinfo
.env
.env.local
.DS_Store
.idea/
.turbo/
.pnpm-store/
*.log
.devdigest/cache/
clones/
playwright-report/
test-results/

# emdash worktree config (local)
.emdash.json

# skill eval runs (generated by skill-creator; test cases live in .claude/skills/<skill>/evals/)
.claude/skill-evals/*/iteration-*/

# pnpm auto-creates an empty root lockfile on `pnpm verify:l06` (root package.json has no deps)
/pnpm-lock.yaml
