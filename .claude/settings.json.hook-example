{
  "//": "Armed pr-self-review gate. Copy the `hooks` block below into .claude/settings.json to make `gh pr create` / `git push` require a fresh passing review (see the skill README → Invocation). This file only preserves the working config; it does nothing while it sits here unplugged.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/skills/pr-self-review/scripts/pr-gate-guard.sh"
          }
        ]
      }
    ]
  }
}
