{
  "permissions": {
    "deny": [
      "Agent(test-writer)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git push*)",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Before executing this git push command, invoke the pr-self-review skill. Run: git diff origin/main...HEAD and review the changes for bugs, leftover debug code and secrets before pushing."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "sdd-engineering@dev-digest-ai-marketplace-stable": true,
    "engineering-paved-path@dev-digest-ai-marketplace-stable": true,
    "research-tools@dev-digest-ai-marketplace-stable": true,
    "architecture-review@dev-digest-ai-marketplace-stable": true,
    "sdd-engineering@dev-digest-ai-marketplace": false,
    "engineering-paved-path@dev-digest-ai-marketplace": false,
    "research-tools@dev-digest-ai-marketplace": false,
    "architecture-review@dev-digest-ai-marketplace": false,
    "security-review@dev-digest-ai-marketplace": false
  },
  "extraKnownMarketplaces": {
    "dev-digest-ai-marketplace-stable": {
      "source": {
        "source": "github",
        "repo": "OlegDEma/devdigest_team_ai_marketplace",
        "ref": "stable"
      }
    }
  }
}
